#!/bin/sh
# Start a rootful Xwayland (one per X11 app → its own Android window) as a client of Hatch's compositor.
# Prints the display number. -nolisten local: never use the abstract socket namespace, which on Android is
# shared with other apps (Termux:X11 etc.) and on hosts with any other X server.
set -eu
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/hatch}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
GEOM="${HATCH_X11_GEOMETRY:-1280x800}"
command -v Xwayland >/dev/null 2>&1 || { echo "hatch: Xwayland missing" >&2; exit 1; }
mkdir -p /tmp/.X11-unix; chmod 1777 /tmp/.X11-unix 2>/dev/null || true
FIFO=$(mktemp -u /tmp/hatch-xdisp.XXXXXX); mkfifo "$FIFO"
LOG=/tmp/hatch-xwayland.$$.log
# shellcheck disable=SC2094
nohup Xwayland -displayfd 3 -nolisten local -nolisten tcp -geometry "$GEOM" -noreset -ac 3>"$FIFO" >"$LOG" 2>&1 &
XPID=$!
DISP=$(timeout 20 head -n1 "$FIFO" || true); rm -f "$FIFO"
[ -n "$DISP" ] || { echo "hatch: Xwayland failed:" >&2; tail -5 "$LOG" >&2; exit 1; }
echo "$DISP $XPID"
