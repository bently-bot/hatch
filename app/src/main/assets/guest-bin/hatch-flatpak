#!/bin/sh
# Flathub apps without bubblewrap (Android has no user namespaces): flatpak only downloads/deploys, and Hatch runs the
# app with proot using Flatpak's own layout (runtime → /usr, app → /app, GL extension → /usr/lib/<triplet>/GL/default).
# usage: hatch-flatpak install <app-id>   (fake root; writes /var/lib/hatch/flatpak/<app-id>.spec)
#        hatch-flatpak spec <app-id>      (rewrite the spec only)
#        hatch-flatpak uninstall <app-id>
# Spec lines (read by the Android launcher and scripts/guest-run.sh): root <dir> | bind <guest-src>:<dst> | env K=V | cmd <argv0> [args]
set -eu
ACT=${1:?action}; ID=${2:?app id}
case "$ID" in *[!A-Za-z0-9._-]*) echo "hatch: bad flatpak id" >&2; exit 2 ;; esac
FP=/var/lib/flatpak; H=/var/lib/hatch/flatpak; SPEC=$H/$ID.spec; SK=$H/$ID.root
export DEBIAN_FRONTEND=noninteractive
# INI value (keys may be written "k=v" or "k = v")
meta() { awk -v s="[$2]" -v k="$3" '$0==s{g=1;next} /^\[/{g=0} g{n=$0; sub(/[ \t]*=.*/,"",n); if(n==k){sub(/^[^=]*=[ \t]*/,""); print; exit}}' "$1"; }
section() { awk -v s="[$2]" '$0==s{g=1;next} /^\[/{g=0} g&&/=/{k=$0; sub(/[ \t]*=.*/,"",k); v=$0; sub(/^[^=]*=[ \t]*/,"",v); print k"="v}' "$1"; }

write_spec() {
  A=$FP/app/$ID/current/active; [ -d "$A/files" ] || A=$(ls -d $FP/app/$ID/*/*/active 2>/dev/null | head -1)
  [ -n "$A" ] && [ -d "$A/files" ] || { echo "hatch: $ID is not deployed" >&2; exit 4; }
  RTREF=$(meta "$A/metadata" Application runtime)            # e.g. org.gnome.Platform/aarch64/51
  CMD=$(meta "$A/metadata" Application command)
  RT=$FP/runtime/$RTREF/active/files
  [ -d "$RT" ] || { echo "hatch: runtime $RTREF missing" >&2; exit 4; }
  RTMETA=$FP/runtime/$RTREF/active/metadata
  GLDIR=$(meta "$RTMETA" "Extension org.freedesktop.Platform.GL" directory)   # lib/<triplet>/GL
  ARCH=$(echo "$RTREF" | cut -d/ -f2)
  GLVER=""; GL=""
  for v in $(meta "$RTMETA" "Extension org.freedesktop.Platform.GL" versions | tr ';' ' ') $(meta "$RTMETA" "Extension org.freedesktop.Platform.GL" version); do
    case "$v" in *-extra) continue ;; esac
    if [ -d "$FP/runtime/org.freedesktop.Platform.GL.default/$ARCH/$v/active/files" ]; then GLVER=$v; GL=$FP/runtime/org.freedesktop.Platform.GL.default/$ARCH/$v/active/files; break; fi
  done
  TRIPLET=$(basename "$(dirname "${GLDIR:-lib/x/GL}")")
  # Skeleton root: /etc entries point into the runtime's /usr/etc like Flatpak does; account/net files come from the guest.
  rm -rf "$SK"; mkdir -p "$SK/usr" "$SK/app" "$SK/etc" "$SK/tmp" "$SK/var/tmp" "$SK/home" "$SK/run/hatch" "$SK/dev" "$SK/proc" "$SK/sys"
  for l in bin lib lib32 lib64 sbin; do [ -e "$RT/$l" ] && ln -s "usr/$l" "$SK/$l"; done
  for e in $(ls "$RT/etc"); do ln -s "/usr/etc/$e" "$SK/etc/$e"; done
  for e in passwd group hosts resolv.conf machine-id localtime; do rm -f "$SK/etc/$e"; : > "$SK/etc/$e"; done
  # Apps/libraries that probe bubblewrap themselves (glycin image loaders, WebKit) must fail fast, not hang under
  # proot: a stub that reports the error they recognise makes them fall back to running unsandboxed.
  mkdir -p "$SK/.hatch/bin"
  printf '#!/bin/sh\necho "bwrap: Creating new namespace failed: Operation not permitted" >&2\nexit 1\n' > "$SK/.hatch/bin/bwrap"
  chmod 755 "$SK/.hatch/bin/bwrap"
  {
    echo "root $SK"
    echo "bind $RT:/usr"
    echo "bind $RT/etc:/usr/etc"
    echo "bind $A/files:/app"
    [ -d "$GL" ] && [ -n "$GLDIR" ] && echo "bind $GL:/usr/$GLDIR/default"
    for e in passwd group hosts resolv.conf machine-id; do echo "bind /etc/$e:/etc/$e"; done
    echo "bind /home:/home"
    section "$RTMETA" Environment | sed 's/^/env /'
    section "$A/metadata" Environment | sed 's/^/env /'
    echo "env PATH=/.hatch/bin:/app/bin:/usr/bin"
    echo "env FLATPAK_ID=$ID"
    echo "env XDG_DATA_DIRS=/app/share:/usr/share:/usr/share/runtime/share"
    echo "env XDG_CONFIG_DIRS=/app/etc/xdg:/etc/xdg"
    echo "env XDG_CONFIG_HOME=/home/hatch/.var/app/$ID/config"
    echo "env XDG_DATA_HOME=/home/hatch/.var/app/$ID/data"
    echo "env XDG_CACHE_HOME=/home/hatch/.var/app/$ID/cache"
    echo "env XDG_STATE_HOME=/home/hatch/.var/app/$ID/.local/state"
    echo "env LD_LIBRARY_PATH=/app/lib:/usr/$GLDIR/default/lib"
    echo "env LIBGL_DRIVERS_PATH=/usr/$GLDIR/default/lib/dri"
    echo "env __EGL_VENDOR_LIBRARY_DIRS=/usr/$GLDIR/default/share/glvnd/egl_vendor.d:/usr/share/glvnd/egl_vendor.d"
    echo "env PULSE_SERVER=tcp:127.0.0.1:47141"
    echo "env NO_AT_BRIDGE=1"
    echo "env GSK_RENDERER=cairo"
    # GNOME 49+ image loading (glycin) sandboxes loaders with bwrap; proot is the sandbox here.
    echo "env GLYCIN_DISABLE_SANDBOX=1"
    echo "cmd $CMD"
  } > "$SPEC.tmp"
  mv "$SPEC.tmp" "$SPEC"
  mkdir -p "/home/hatch/.var/app/$ID/config" "/home/hatch/.var/app/$ID/data" "/home/hatch/.var/app/$ID/cache"
  chown -R 1000:1000 "/home/hatch/.var" 2>/dev/null || true
  echo "hatch: flatpak $ID ready ($RTREF${TRIPLET:+, GL $GLVER})"
}

case "$ACT" in
  install)
    if ! command -v flatpak >/dev/null 2>&1; then
      echo "hatch: installing flatpak"
      apt-get install -y --no-install-recommends -o APT::Status-Fd=3 flatpak ca-certificates 3>&1 \
        || { apt-get update && apt-get install -y --no-install-recommends flatpak ca-certificates; }
    fi
    flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    # Only English locale extensions (the full GNOME locale pack is ~1 GB).
    flatpak config --system --set languages en >/dev/null 2>&1 || true
    echo "hatch: checking Flathub's $ID"
    # Sizes for the store's "N MB to download - M GB on disk", in apt's own wording so one parser handles both.
    info() { flatpak remote-info --system flathub "$1" 2>/dev/null; }
    field() { sed -n "s/^ *$1: *//p" | head -1; }
    bytes() { sed 's/\xc2\xa0/ /g' | awk '{v=$1; gsub(/[^0-9.]/,"",v); u=$2; if(u=="kB"||u=="KB")m=1e3; else if(u=="MB")m=1e6; else if(u=="GB")m=1e9; else m=1; printf "%d", v*m}'; }
    AI=$(info "$ID"); [ -n "$AI" ] || { echo "hatch: $ID not found on Flathub" >&2; exit 4; }
    DL=$(echo "$AI" | field Download | bytes); DISK=$(echo "$AI" | field Installed | bytes)
    RTREF=$(echo "$AI" | field Runtime)
    if [ -n "$RTREF" ] && ! flatpak info --system "$RTREF" >/dev/null 2>&1; then
      RI=$(info "runtime/$RTREF"); DL=$((DL + $(echo "$RI" | field Download | bytes))); DISK=$((DISK + $(echo "$RI" | field Installed | bytes)))
    fi
    [ "$DL" -gt 0 ] && echo "Need to get $((DL / 1000)) kB of archives."
    [ "$DISK" -gt 0 ] && echo "After this operation, $((DISK / 1000)) kB of additional disk space will be used."
    echo "hatch: downloading $ID from Flathub"
    mkdir -p $FP/repo/objects; BASE=$(du -sk $FP/repo/objects 2>/dev/null | cut -f1)
    # bwrap can't create namespaces here: its export/trigger steps print errors but the deploy itself succeeds.
    ( flatpak install --system -y --noninteractive flathub "$ID" 2>&1; echo "flatpak-exit:$?" ) | grep -v 'bwrap: Creating new namespace failed' > /tmp/hatch-flatpak.$$ &
    BG=$!
    while kill -0 $BG 2>/dev/null; do
      sleep 3
      if [ "${DL:-0}" -gt 0 ]; then
        NOW=$(du -sk $FP/repo/objects 2>/dev/null | cut -f1); PCT=$(( (NOW - BASE) * 100000 / DL ))
        [ "$PCT" -gt 99 ] && PCT=99; echo "dlstatus:1:$PCT:Downloading"
      fi
    done
    wait $BG || true
    cat /tmp/hatch-flatpak.$$; R=$(sed -n 's/^flatpak-exit://p' /tmp/hatch-flatpak.$$); rm -f /tmp/hatch-flatpak.$$
    [ -d "$FP/app/$ID" ] || { echo "hatch: flatpak install failed (exit ${R:-?})" >&2; exit 5; }
    echo "pmstatus:$ID:90:Setting up $ID"
    write_spec ;;
  spec) write_spec ;;
  uninstall)
    flatpak uninstall --system -y --noninteractive "$ID" 2>&1 | grep -v bwrap || true
    flatpak uninstall --system -y --noninteractive --unused 2>&1 | grep -v bwrap || true
    rm -rf "$SPEC" "$SK" ;;
  *) echo "usage: hatch-flatpak install|spec|uninstall <app-id>" >&2; exit 2 ;;
esac
