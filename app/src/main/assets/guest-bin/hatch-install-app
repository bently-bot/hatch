#!/bin/sh
# Hatch guest installer. Same script is used by the Android app and by CI.
# usage: hatch-install-app [--packages "a b"] [--payload URL SHA256 DEST] [--wine]
set -eu
PKGS=""; URL=""; SHA=""; DEST=""; WINE=0; DESKTOP=""
while [ $# -gt 0 ]; do
  case "$1" in
    --packages) PKGS="$2"; shift 2 ;;
    --payload) URL="$2"; SHA="$3"; DEST="$4"; shift 4 ;;
    --wine) WINE=1; shift ;;
    --desktop) DESKTOP="$2"; shift 2 ;;
    *) echo "unknown arg $1" >&2; exit 2 ;;
  esac
done
export DEBIAN_FRONTEND=noninteractive
if [ "$WINE" = 1 ]; then PKGS="$PKGS wine wine64 libwine fonts-wine"; fi
if [ -n "$URL" ]; then PKGS="$PKGS curl ca-certificates unzip"; fi
# Sound: one shared PulseAudio (hatch-audio) for every app; ALSA-only apps go through the pulse plugin.
command -v pulseaudio >/dev/null 2>&1 || PKGS="$PKGS pulseaudio pulseaudio-utils libasound2-plugins"
[ -f /etc/asound.conf ] || printf 'pcm.!default { type pulse }\nctl.!default { type pulse }\n' > /etc/asound.conf
# Xwayland aborts without libEGL (it probes glamor even when it falls back to shm)
case " $PKGS " in *" xwayland "*) PKGS="$PKGS libegl1 libgl1-mesa-dri xfonts-base matchbox-window-manager" ;; esac
PKGS=$(echo $PKGS | tr ' ' '\n' | awk 'NF && !seen[$0]++' | tr '\n' ' ')
mkdir -p /etc/apt/preferences.d /var/lib/dpkg/updates
# Recover from an interrupted dpkg run (app killed mid-install, phone rebooted, …)
dpkg --configure -a >/dev/null 2>&1 || true
if [ -n "$PKGS" ]; then
  echo "hatch: apt install $PKGS"
  # Refresh lists if older than a day (or missing)
  if [ -z "$(find /var/lib/apt/lists -maxdepth 1 -name '*Packages*' -mtime -1 2>/dev/null | head -1)" ]; then
    apt-get update
  fi
  # shellcheck disable=SC2086
  apt-get install -y --no-install-recommends $PKGS || { apt-get update && apt-get install -y --no-install-recommends $PKGS; }
fi
if [ -n "$URL" ]; then
  mkdir -p "$DEST"
  TMP="/tmp/hatch-payload.$$"
  echo "hatch: download $URL"
  curl -fL --retry 3 -o "$TMP" "$URL"
  if [ -n "$SHA" ]; then
    echo "$SHA  $TMP" | sha256sum -c - >/dev/null || { echo "hatch: sha256 mismatch" >&2; rm -f "$TMP"; exit 4; }
  fi
  case "$URL" in
    *.zip) unzip -qo "$TMP" -d "$DEST" ;;
    *.tar.*|*.tgz) tar -xf "$TMP" -C "$DEST" ;;
    *) cp "$TMP" "$DEST/" ;;
  esac
  rm -f "$TMP"
fi
if [ -n "$DESKTOP" ]; then
  # Per-toolkit extras: Qt needs its Wayland platform plugin; X11-only toolkits / terminal apps need Xwayland.
  F=/usr/share/applications/$DESKTOP
  XSTACK="xwayland libegl1 libgl1-mesa-dri xfonts-base matchbox-window-manager xterm"
  field() { awk -v k="$1" '/^\[/{g=($0=="[Desktop Entry]")} g&&index($0,k"=")==1{sub(/^[^=]*=/,"");print;exit}' "$F" 2>/dev/null; }
  BIN=$(field Exec | awk '{print $1}'); BIN=$(command -v "$BIN" 2>/dev/null || true)
  EXTRA=""
  if [ "$(field Terminal)" = true ]; then EXTRA="$XSTACK"
  elif [ -n "$BIN" ] && head -c 4 "$BIN" | grep -q ELF; then
    LIBS=$(ldd "$BIN" 2>/dev/null || true)
    case "$LIBS" in *libQt5Gui*) EXTRA="qtwayland5" ;; *libQt6Gui*) EXTRA="qt6-wayland" ;; esac
    if ! echo "$LIBS" | grep -Eq 'libgtk-3|libgtk-4|libQt5Gui|libQt6Gui|libSDL2|libSDL3|libwayland-client|libKF[56]'; then
      echo "hatch: $DESKTOP is X11-only → installing Xwayland"; EXTRA="$XSTACK"
    fi
  fi
  [ -z "$EXTRA" ] || apt-get install -y --no-install-recommends $EXTRA
fi
if [ "$WINE" = 1 ]; then
  echo "hatch: wine prefix will initialise on first launch"
fi
echo "hatch: install ok"
