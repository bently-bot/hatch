#!/bin/sh
# Hatch guest installer. Same script is used by the Android app and by CI.
# usage: hatch-install-app [--packages "a b"] [--repo ID KEYURL URIS SUITES COMPONENTS] [--payload URL SHA256 DEST] [--wine]
set -eu
PKGS=""; URL=""; SHA=""; DEST=""; WINE=0; DESKTOP=""; REPO=""
while [ $# -gt 0 ]; do
  case "$1" in
    --packages) PKGS="$2"; shift 2 ;;
    --payload) URL="$2"; SHA="$3"; DEST="$4"; shift 4 ;;
    --repo) REPO="$2"; RKEY="$3"; RURIS="$4"; RSUITES="$5"; RCOMP="$6"; shift 6 ;;
    --wine) WINE=1; shift ;;
    --desktop) DESKTOP="$2"; shift 2 ;;
    *) echo "unknown arg $1" >&2; exit 2 ;;
  esac
done
export DEBIAN_FRONTEND=noninteractive
# Mirrors/CDNs hiccup (5xx, resets); never fail an install on one bad response.
# Vendor packages (Cursor, VS Code, Chrome, Brave…) install their own sources entry for their repo on first install.
# Ours only bootstraps that: once the vendor's entry exists, drop ours (apt rejects two Signed-By for one source).
vendor_has() { u=$(echo "$1" | sed 's:/*$::'); grep -lsF "$u" /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null | grep -qv '/hatch-[^/]*\.sources$'; }
dedupe_sources() {
  for f in /etc/apt/sources.list.d/hatch-*.sources; do
    [ -e "$f" ] || continue
    u=$(sed -n 's/^URIs: *//p' "$f")
    if [ -n "$u" ] && vendor_has "$u"; then echo "hatch: $(basename "$f") superseded by the vendor's own entry"; rm -f "$f"; fi
  done
}
dedupe_sources
apt_update() { for i in 1 2 3 4; do apt-get update && return 0; echo "hatch: apt update failed, retrying ($i)"; sleep $((i*3)); done; return 1; }
if [ "$WINE" = 1 ]; then PKGS="$PKGS wine wine64 libwine fonts-wine"; fi
if [ -n "$URL" ]; then PKGS="$PKGS curl ca-certificates unzip"; fi
# Sound: one shared PulseAudio (hatch-audio) for every app; ALSA-only apps go through the pulse plugin.
command -v pulseaudio >/dev/null 2>&1 || PKGS="$PKGS pulseaudio pulseaudio-utils libasound2-plugins"
[ -f /etc/asound.conf ] || printf 'pcm.!default { type pulse }\nctl.!default { type pulse }\n' > /etc/asound.conf
# Xwayland aborts without libEGL (it probes glamor even when it falls back to shm)
case " $PKGS " in *" xwayland "*) PKGS="$PKGS libegl1 libgl1-mesa-dri xfonts-base matchbox-window-manager" ;; esac
PKGS=$(echo $PKGS | tr ' ' '\n' | awk 'NF && !seen[$0]++' | tr '\n' ' ')
mkdir -p /etc/apt/preferences.d /var/lib/dpkg/updates
# Recover from an interrupted dpkg run (app killed mid-install, phone rebooted, …)
dpkg --configure -a >/dev/null 2>&1 || true
FORCE_UPDATE=0
if [ -n "$REPO" ]; then
  # Vendor apt repository (deb822 + its own signing key), like adding Cursor's or VS Code's repo by hand.
  case "$REPO" in *[!a-z0-9.-]*|"") echo "hatch: bad repo id" >&2; exit 2 ;; esac
  SRC=/etc/apt/sources.list.d/hatch-$REPO.sources
  if [ ! -s "$SRC" ] && ! vendor_has "$RURIS"; then
    echo "hatch: adding $REPO's repository ($RURIS)"
    command -v curl >/dev/null 2>&1 && [ -e /etc/ssl/certs/ca-certificates.crt ] || {
      apt-get update >/dev/null 2>&1 || true
      apt-get install -y --no-install-recommends curl ca-certificates >/dev/null || { echo "hatch: could not install curl" >&2; exit 5; }
    }
    mkdir -p /etc/apt/keyrings /etc/apt/sources.list.d
    KTMP=/etc/apt/keyrings/hatch-$REPO.key.tmp
    curl -fsSL --retry 3 -o "$KTMP" "$RKEY" || { echo "hatch: could not download $REPO's signing key" >&2; exit 5; }
    # apt's Signed-By takes an armored .asc or a binary keyring (.gpg); keep the vendor's format.
    if head -c 40 "$KTMP" | grep -q 'BEGIN PGP'; then KEY=/etc/apt/keyrings/hatch-$REPO.asc; else KEY=/etc/apt/keyrings/hatch-$REPO.gpg; fi
    mv "$KTMP" "$KEY"
    printf 'Types: deb\nURIs: %s\nSuites: %s\nComponents: %s\nArchitectures: %s\nSigned-By: %s\n' \
      "$RURIS" "$RSUITES" "$RCOMP" "$(dpkg --print-architecture)" "$KEY" > "$SRC"
    FORCE_UPDATE=1
  fi
fi
if [ -n "$PKGS" ]; then
  echo "hatch: apt install $PKGS"
  # Refresh lists if older than a day (or missing)
  if [ "$FORCE_UPDATE" = 1 ] || [ -z "$(find /var/lib/apt/lists -maxdepth 1 -name '*Packages*' -mtime -1 2>/dev/null | head -1)" ]; then
    apt_update
  fi
  # shellcheck disable=SC2086
  # Machine-readable "dlstatus:/pmstatus:" lines on fd 3 (dup'ed onto stdout) drive the store's progress bar.
  # Not Status-Fd=1 + Dpkg::Use-Pty=0: maintainer scripts then hit EIO writing to stdout under proot (fontconfig, gstreamer…).
  apt-get install -y --no-install-recommends -o APT::Status-Fd=3 $PKGS 3>&1 || { apt_update && apt-get install -y --no-install-recommends -o APT::Status-Fd=3 $PKGS 3>&1; }
fi
dedupe_sources
if [ -n "$URL" ]; then
  mkdir -p "$DEST"
  TMP="/tmp/hatch-payload.$$"
  echo "hatch: download $URL"
  curl -fL --retry 3 -o "$TMP" "$URL"
  if [ -n "$SHA" ]; then
    echo "$SHA  $TMP" | sha256sum -c - >/dev/null || { echo "hatch: sha256 mismatch" >&2; rm -f "$TMP"; exit 4; }
  fi
  case "$URL" in
    *.zip) unzip -qo "$TMP" -d "$DEST" ;;
    *.appimage|*.AppImage)
      # No FUSE on Android: unpack the AppImage once (its own runtime does this) and run AppRun from the tree.
      chmod +x "$TMP"; rm -rf "$DEST/app" "$DEST/squashfs-root"
      ( cd "$DEST" && "$TMP" --appimage-extract >/dev/null ) || { echo "hatch: could not unpack the AppImage" >&2; rm -f "$TMP"; exit 4; }
      mv "$DEST/squashfs-root" "$DEST/app"; chmod -R a+rX "$DEST/app" ;;
    *.tar.*|*.tgz) tar -xf "$TMP" -C "$DEST" ;;
    *) cp "$TMP" "$DEST/" ;;
  esac
  rm -f "$TMP"
fi
if [ -n "$DESKTOP" ]; then
  # Per-toolkit extras: Qt needs its Wayland platform plugin; X11-only toolkits / terminal apps need Xwayland.
  F=/usr/share/applications/$DESKTOP
  XSTACK="xwayland libegl1 libgl1-mesa-dri xfonts-base matchbox-window-manager xterm"
  field() { awk -v k="$1" '/^\[/{g=($0=="[Desktop Entry]")} g&&index($0,k"=")==1{sub(/^[^=]*=/,"");print;exit}' "$F" 2>/dev/null; }
  BIN=$(field Exec | awk '{print $1}'); BIN=$(command -v "$BIN" 2>/dev/null || true)
  EXTRA=""
  if [ "$(field Terminal)" = true ]; then EXTRA="$XSTACK"
  elif [ -n "$BIN" ] && head -c 4 "$BIN" | grep -q ELF; then
    LIBS=$(ldd "$BIN" 2>/dev/null || true)
    case "$LIBS" in *libQt5Gui*) EXTRA="qtwayland5" ;; *libQt6Gui*) EXTRA="qt6-wayland" ;; esac
    if ! echo "$LIBS" | grep -Eq 'libgtk-3|libgtk-4|libQt5Gui|libQt6Gui|libSDL2|libSDL3|libwayland-client|libKF[56]'; then
      echo "hatch: $DESKTOP is X11-only → installing Xwayland"; EXTRA="$XSTACK"
    fi
  fi
  [ -z "$EXTRA" ] || apt-get install -y --no-install-recommends -o APT::Status-Fd=3 $EXTRA 3>&1
fi
if [ "$WINE" = 1 ]; then
  echo "hatch: wine prefix will initialise on first launch"
fi
echo "hatch: install ok"
