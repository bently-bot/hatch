#!/bin/sh
# Hatch guest launcher. usage: hatch-launch [--wine] [--x11] -- cmd args...
# Expects WAYLAND_DISPLAY/XDG_RUNTIME_DIR pointing at Hatch's compositor.
set -eu
WINE=0; X11=0
while [ $# -gt 0 ]; do
  case "$1" in
    --wine) WINE=1; shift ;;
    --x11) X11=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ -x /usr/local/bin/hatch-audio-env ] && . /usr/local/bin/hatch-audio-env || true
case ":$PATH:" in *:/usr/games:*) ;; *) export PATH="$PATH:/usr/games" ;; esac
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/hatch}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
# Chromium/Electron choose Wayland vs X11 from the session type.
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}" ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
export NO_AT_BRIDGE=1 GTK_A11Y=none
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
# XDG base dirs must exist: under proot, stat() on a child of a missing dir can fail with ENOSYS instead of ENOENT
# (std::filesystem::status → "Function not implemented", e.g. HDRView as the first app on a fresh home).
mkdir -p "${HOME:-/home/hatch}/.config" "${HOME:-/home/hatch}/.local/share" "${HOME:-/home/hatch}/.local/state" "${HOME:-/home/hatch}/.cache" 2>/dev/null || true
if [ "$WINE" = 1 ]; then
  unset DISPLAY
  # Debian wine 10 bug: server_tmpdir.h free()s secure_getenv("TMPDIR") → "free(): invalid pointer" abort.
  unset TMPDIR
  export WINEPREFIX="${WINEPREFIX:-$HOME/.wine}"
  # Debian's wine puts wineserver's socket dir in /run/user/<uid>/wine when that exists (else it creat()s a marker file
  # in the prefix, which x86_64 Android's seccomp rejects).
  RUN="/run/user/$(id -u)"; mkdir -p "$RUN" 2>/dev/null && chmod 700 "$RUN" 2>/dev/null || true
  # Android forbids execmod (mprotect +X on written file pages) for API 29+ apps; Wine does exactly that when loading PE images.
  # The shim retries those as anonymous executable memory, which is allowed.
  [ -f /usr/local/lib/hatch/libhatch-execmod.so ] && export LD_PRELOAD="/usr/local/lib/hatch/libhatch-execmod.so${LD_PRELOAD:+:$LD_PRELOAD}"
  # Diagnostics hook: /etc/hatch/winedebug (e.g. "+timestamp,+loaddll,err") overrides the quiet default.
  [ -z "${WINEDEBUG:-}" ] && [ -s /etc/hatch/winedebug ] && WINEDEBUG=$(cat /etc/hatch/winedebug)
  export WINEDEBUG="${WINEDEBUG:--all}"
  export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"
  if [ ! -f "$WINEPREFIX/system.reg" ]; then
    echo "hatch: initialising Wine prefix (first run)…"
    # Runs with the Wayland display available so the progress dialog renders.
    wineboot -u || wine wineboot -u
    wine reg add 'HKCU\Software\Wine\Drivers' /v Graphics /t REG_SZ /d wayland /f >/dev/null 2>&1 || true
  fi
  case "${1:-}" in wine|wine64) shift ;; esac
  exec wine "$@"
fi
if [ "$X11" = 1 ]; then
  case "${1:-}" in hatch-x11) shift ;; esac
  # Electron/Chromium on the X11 rung want a session bus like on Wayland
  if command -v dbus-run-session >/dev/null 2>&1 && [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- /usr/local/bin/hatch-x11 "$@"
  fi
  exec /usr/local/bin/hatch-x11 "$@"
fi
export GDK_BACKEND="${GDK_BACKEND:-wayland}" QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
if command -v dbus-run-session >/dev/null 2>&1 && [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  exec dbus-run-session -- "$@"
fi
exec "$@"
